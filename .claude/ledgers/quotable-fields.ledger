# Which fields of a SlideRecord a quote resolves against, owned by `slideFields` in
# packages/shared/src/quotable-text.ts (docs/standards/architecture.md rule 9; #202, #302). Every
# reader of quotable text goes through it, textHashOf included, so a confirmation of derived text
# is voided by an edit to exactly the text a quote could come from (docs/adr/0006-image-only-slides.md § Decision (g)).
owner: packages/shared/src/quotable-text.ts
claim: the fields a quote resolves against are the ones slideFields returns, and every reader of quotable text reads them from it
sweep: \.claude/ledgers/quotable-fields\.ledger|\bslideFields\b|(?i:fields a quote resolves|quotable fields)
scope: :!pnpm-lock.yaml
carrier: packages/shared/src/index.ts
carrier: packages/shared/src/quotable-text.test.ts
carrier: packages/shared/src/embed-text.ts
carrier: packages/grounding/src/slide-text.ts
carrier: packages/index/src/confirmation.ts
carrier: packages/index/src/confirmation.test.ts
carrier: apps/web/src/ask/quote-marks.ts
carrier: apps/web/src/ask/quote-marks.test.ts
