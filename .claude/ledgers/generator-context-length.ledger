# The generator's context length, owned by PROVISIONAL_GENERATOR_CONTEXT_LENGTH in
# packages/gateway/src/provisional-pins.ts (docs/standards/architecture.md rule 9; #302).
# Developer mode's Modelfile num_ctx is read from it through generator-pin.mjs, and the
# installed app's backend (#7) is to apply it. The arms include node-llama-cpp's contextSize.
owner: packages/gateway/src/provisional-pins.ts
claim: developer mode serves the generator with PROVISIONAL_GENERATOR_CONTEXT_LENGTH, never above the artefact's trained length, and the installed app's backend is to apply the same value
sweep: \.claude/ledgers/generator-context-length\.ledger|PROVISIONAL_GENERATOR_CONTEXT_LENGTH|num_ctx|\bn_ctx\b|(?i:context[ _-]?(length|size|window))
scope: :!pnpm-lock.yaml
carrier: .claude/scripts/generator-pin.mjs
carrier: .claude/scripts/models-pull.sh
carrier: .claude/scripts/models-pull.test.sh
carrier: packages/gateway/src/index.ts
carrier: docs/adr/0003-model-roles-and-backends.md
